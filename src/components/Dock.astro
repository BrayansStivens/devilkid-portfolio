---
import { asset, route, type Lang } from '../lib/paths';
import { mailLink, waLink, type SectionId } from '../data/site';
import { t } from '../i18n/ui';

interface Props {
  lang: Lang;
  page: 'home' | SectionId;
}
const { lang, page } = Astro.props;
const s = t(lang);

const folders: { id: SectionId; icon: string }[] = [
  { id: 'fashion', icon: 'ui/dock-fashion.webp' },
  { id: 'art', icon: 'ui/dock-art.webp' },
  { id: 'visuals', icon: 'ui/dock-visuals.webp' },
  { id: 'typography', icon: 'ui/dock-type.webp' },
  { id: 'aboutme', icon: 'ui/dock-about.webp' },
];
---

<nav class="dock" aria-label="Dock">
  <ul class="dock__shelf" data-dock>
    <li class="dock__home">
      <a class="dock__item" href={route(lang)} aria-current={page === 'home' ? 'page' : undefined}>
        <span class="dock__icon dock__icon--home"><span class="devil-gel" aria-hidden="true"></span></span>
        <span class="dock__label">{s.dock.home}</span>
      </a>
    </li>
    {
      folders.map((f) => (
        <li>
          <a class="dock__item" href={route(lang, f.id)} aria-current={page === f.id ? 'page' : undefined}>
            <span class="dock__icon">
              <img src={asset(f.icon)} alt="" width="192" height="192" decoding="async" />
            </span>
            <span class="dock__label">{s.dock[f.id]}</span>
          </a>
        </li>
      ))
    }
    <li class="dock__sep" aria-hidden="true"></li>
    <li>
      <a class="dock__item" href={waLink(s.waHello)} target="_blank" rel="noopener noreferrer">
        <span class="dock__icon dock__icon--chat">
          <svg viewBox="0 0 32 32" aria-hidden="true">
            <path
              fill="currentColor"
              d="M16 4C8.8 4 3 8.9 3 15c0 3.2 1.6 6.1 4.2 8.1-.3 1.7-1.2 3.4-2.7 4.7 2.8-.1 5.2-1 7-2.4 1.4.4 2.9.6 4.5.6 7.2 0 13-4.9 13-11S23.2 4 16 4Z"
            ></path>
          </svg>
        </span>
        <span class="dock__label">{s.dock.whatsapp}</span>
      </a>
    </li>
    <li>
      <a class="dock__item" href={mailLink(s.about.subject)}>
        <span class="dock__icon dock__icon--mail"><span aria-hidden="true">@</span></span>
        <span class="dock__label">{s.dock.mail}</span>
      </a>
    </li>
  </ul>
</nav>

<script>
  // Dock magnification: icons swell toward the pointer along a cosine curve and
  // ease in and out, pushing their neighbours aside as the real one did.
  const shelf = document.querySelector<HTMLElement>('[data-dock]');
  const fine = window.matchMedia('(hover: hover) and (pointer: fine) and (min-width: 761px)');
  const still = window.matchMedia('(prefers-reduced-motion: reduce)');
  if (shelf) {
    const items = [...shelf.querySelectorAll<HTMLElement>('.dock__item')];
    const BASE = 52;
    const PEAK = 42;
    const REACH = 168;
    const size = items.map(() => BASE);
    let centers: number[] = [];
    let pointerX: number | null = null;
    let raf = 0;

    // Rest positions, measured while nothing is magnified, so the swelling
    // itself never feeds back into where the pointer "is".
    const measure = () => {
      centers = items.map((item) => {
        const r = item.getBoundingClientRect();
        return r.left + r.width / 2;
      });
    };

    const frame = () => {
      raf = 0;
      let moving = false;
      items.forEach((item, i) => {
        let goal = BASE;
        if (pointerX !== null) {
          const k = Math.min(1, Math.abs(pointerX - centers[i]) / REACH);
          goal = BASE + (PEAK * (Math.cos(k * Math.PI) + 1)) / 2;
        }
        size[i] += (goal - size[i]) * 0.3;
        if (Math.abs(goal - size[i]) > 0.2) moving = true;
        else size[i] = goal;
        if (size[i] === BASE) item.style.removeProperty('--size');
        else item.style.setProperty('--size', `${size[i].toFixed(1)}px`);
      });
      if (moving) raf = requestAnimationFrame(frame);
    };
    const run = () => {
      if (!raf) raf = requestAnimationFrame(frame);
    };

    shelf.addEventListener('pointerenter', () => {
      if (size.every((v) => v === BASE)) measure();
    });
    shelf.addEventListener('pointermove', (e) => {
      if (!fine.matches || still.matches || e.pointerType !== 'mouse') return;
      if (!centers.length) measure();
      pointerX = e.clientX;
      run();
    });
    shelf.addEventListener('pointerleave', () => {
      pointerX = null;
      run();
    });
    const reset = () => {
      pointerX = null;
      centers = [];
      size.fill(BASE);
      for (const item of items) item.style.removeProperty('--size');
    };
    fine.addEventListener('change', reset);
    window.addEventListener('resize', reset);
  }
</script>
